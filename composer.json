{
    "name": "lumoauth/symfony-bundle",
    "description": "LumoAuth for Symfony: configuration, an autowired LumoAuth client, and an access-token handler for the security component.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["lumoauth", "symfony", "bundle", "auth", "oauth", "authorization"],
    "homepage": "https://lumoauth.dev",
    "require": {
        "php": "^8.1",
        "lumoauth/lumoauth": "^0.1",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/security-http": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": { "LumoAuth\\Symfony\\": "src/" }
    },
    "config": { "sort-packages": true }
}
